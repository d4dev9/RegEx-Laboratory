# Copy to .env.local for development, and set every value in your dashboard for production. Never commit a filled-in copy of this file.

# ---- Supabase ----
# The browser never contacts the auth service, so none of these three carry the NEXT_PUBLIC_ prefix.
# Project URL. Example: https://abcxyz.supabase.co
SUPABASE_URL=#PasteYourProjectUrl

# Anon key. Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=#YourAnonKey

# Service role key: it deletes the auth identity when a user erases their account.
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=#YourServiceRoleKey

# ---- Database ----
# Application: transaction-mode pooler, port 6543.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=#PasteYourPoolerUrl

# Migrations only: session mode, port 5432. The two are not interchangeable.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?pgbouncer=false
DIRECT_URL=#PasteYourDirectUrl

# ---- Site ----
# Absolute origin, no trailing slash. Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=#PasteYourSiteUrl
