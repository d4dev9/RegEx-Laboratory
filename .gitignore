# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage/

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production
/build

# Environment
# `.env*` covers every variant. The negation is what keeps the template in the
# repo: without it `.env.example` is ignored too and a fresh clone has nothing to
# copy. Secrets live in `.env`, which is never committed.
.env
.env.local
.env*.local
.env*
!.env.example

# Vercel
.vercel

# Prisma
# Migrations are committed on purpose: production deploys run `prisma migrate
# deploy`, which needs the migration history. Only the generated client is build
# output.
prisma/*.db
prisma/*.db-journal
/src/generated/

# Playwright
# The browser suite is not part of this snapshot. See docs/TESTING.md to set it
# up locally; these are the artifacts it leaves behind.
/.playwright-cli/
/playwright-report/
/playwright-reports/
/test-results/
/blob-report/

# Editors and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tree dumps from `tree` and from ad-hoc repo inspection
*tree*.txt
project-tree.txt

# Local audit output
/audit-preview/
/auditoria.txt

# Written by `next dev` itself (next/dist/server/lib/generate-agent-files.js) and
# recreated on every run, so they are local artifacts rather than repo content.
/AGENTS.md
